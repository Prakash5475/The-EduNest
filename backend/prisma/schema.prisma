model Role {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  uuid String @default(uuid()) @db.Char(36)
  name String @db.VarChar(60)
  slug String @db.VarChar(60)
  description String? @db.VarChar(255)
  isSystem Boolean @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  @@unique([slug], map: "uq_roles_slug")
  @@unique([uuid], map: "uq_roles_uuid")
  rolePermissions RolePermission[] @relation("fk_rp_role")
  userRoles UserRole[] @relation("fk_ur_role")
  @@map("roles")
}

model Permission {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  uuid String @default(uuid()) @db.Char(36)
  name String @db.VarChar(100)
  module String @db.VarChar(60)
  description String? @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@unique([name], map: "uq_permissions_name")
  @@index([module], map: "idx_permissions_module")
  rolePermissions RolePermission[] @relation("fk_rp_permission")
  @@map("permissions")
}

model RolePermission {
  roleId BigInt @map("role_id") @db.UnsignedBigInt
  permissionId BigInt @map("permission_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at")
  @@id([roleId, permissionId])
  role Role @relation("fk_rp_role", fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation("fk_rp_permission", fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@map("role_permissions")
}

