enum WhatsappConversationState {
  idle
  awaiting_quotation_price
  awaiting_quotation_confirmation
  awaiting_work_order_ack
  awaiting_dispatch_details
  awaiting_delivery_confirmation
}

/// One row per dealer — the dealer's only "session" in the system now that there is no
/// login portal for dealers (v1.0 decision: dealers interact exclusively via WhatsApp).
/// Tracks which step of a conversational flow (quotation negotiation, work-order
/// acknowledgement, dispatch capture, delivery confirmation) the dealer is currently in.
model WhatsappConversation {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  dealerId BigInt @map("dealer_id") @db.UnsignedBigInt
  phone String @db.VarChar(20)
  state WhatsappConversationState @default(idle)
  contextData Json? @map("context_data")
  referenceType String? @map("reference_type") @db.VarChar(50)
  referenceId BigInt? @map("reference_id") @db.UnsignedBigInt
  lastInboundAt DateTime? @map("last_inbound_at")
  lastOutboundAt DateTime? @map("last_outbound_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  dealer Dealer @relation("fk_whatsappconv_dealer", fields: [dealerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inboundMessages WhatsappInboundMessage[] @relation("fk_whatsappinbound_conversation")
  @@unique([dealerId], map: "uq_whatsappconv_dealer")
  @@index([phone], map: "idx_whatsappconv_phone")
  @@map("whatsapp_conversations")
}

/// Raw log of every inbound WhatsApp message received via the Meta webhook, independent of
/// WhatsappMessageLog (which is outbound-only). Kept even for messages that fail to process,
/// so nothing Meta delivers is ever silently dropped.
model WhatsappInboundMessage {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  conversationId BigInt? @map("conversation_id") @db.UnsignedBigInt
  providerMessageId String @map("provider_message_id") @db.VarChar(100)
  fromPhone String @map("from_phone") @db.VarChar(20)
  messageType String @map("message_type") @db.VarChar(30)
  bodyText String? @map("body_text") @db.Text
  rawPayload Json @map("raw_payload")
  processedAt DateTime? @map("processed_at")
  processingError String? @map("processing_error") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  conversation WhatsappConversation? @relation("fk_whatsappinbound_conversation", fields: [conversationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  @@unique([providerMessageId], map: "uq_whatsappinbound_providermsgid")
  @@index([fromPhone], map: "idx_whatsappinbound_fromphone")
  @@index([processedAt], map: "idx_whatsappinbound_processedat")
  @@map("whatsapp_inbound_messages")
}
