generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String           @unique(map: "uq_roles_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  name            String           @db.VarChar(60)
  slug            String           @unique(map: "uq_roles_slug") @db.VarChar(60)
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamp(0)
  rolePermissions RolePermission[] @relation("fk_rp_role")
  userRoles       UserRole[]       @relation("fk_ur_role")

  @@map("roles")
}

model Permission {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String           @default(dbgenerated("(uuid())")) @db.Char(36)
  name            String           @unique(map: "uq_permissions_name") @db.VarChar(100)
  module          String           @db.VarChar(60)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  rolePermissions RolePermission[] @relation("fk_rp_permission")

  @@index([module], map: "idx_permissions_module")
  @@map("permissions")
}

model RolePermission {
  roleId       BigInt     @map("role_id") @db.UnsignedBigInt
  permissionId BigInt     @map("permission_id") @db.UnsignedBigInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  permission   Permission @relation("fk_rp_permission", fields: [permissionId], references: [id], onDelete: Cascade, map: "fk_rp_permission")
  role         Role       @relation("fk_rp_role", fields: [roleId], references: [id], onDelete: Cascade, map: "fk_rp_role")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "fk_rp_permission")
  @@map("role_permissions")
}

model User {
  id                                  BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                String                       @unique(map: "uq_users_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  fullName                            String                       @map("full_name") @db.VarChar(150)
  email                               String                       @unique(map: "uq_users_email") @db.VarChar(190)
  phone                               String?                      @db.VarChar(20)
  passwordHash                        String                       @map("password_hash") @db.VarChar(255)
  userType                            UserUserType                 @map("user_type")
  status                              UserStatus                   @default(pending_verification)
  emailVerifiedAt                     DateTime?                    @map("email_verified_at") @db.Timestamp(0)
  phoneVerifiedAt                     DateTime?                    @map("phone_verified_at") @db.Timestamp(0)
  lastLoginAt                         DateTime?                    @map("last_login_at") @db.Timestamp(0)
  failedLoginCount                    Int                          @default(0) @map("failed_login_count") @db.UnsignedSmallInt
  lockedUntil                         DateTime?                    @map("locked_until") @db.Timestamp(0)
  createdAt                           DateTime                     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                           DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt                           DateTime?                    @map("deleted_at") @db.Timestamp(0)
  activityLogs                        ActivityLog[]                @relation("fk_activitylogs_user")
  blogs                               Blog[]                       @relation("fk_blogs_author")
  cancellations                       Cancellation[]               @relation("fk_cancellations_user")
  certificates                        Certificate[]                @relation("fk_certificates_user")
  customizationRequests               CustomizationRequest[]       @relation("fk_customreq_reviewer")
  customizationStatusHistory          CustomizationStatusHistory[] @relation("fk_customstatushist_user")
  dashboardWidgets                    DashboardWidget[]            @relation("fk_dashwidget_user")
  dealerQuotations                    DealerQuotation[]            @relation("fk_dealerquot_assignedby")
  dealers                             Dealer[]                     @relation("fk_dealers_user")
  deliveryUpdates                     DeliveryUpdate[]             @relation("fk_deliveryupdates_user")
  deviceTokens                        DeviceToken[]                @relation("fk_devicetok_user")
  downloads                           Download[]                   @relation("fk_downloads_user")
  eventRegistrations                  EventRegistration[]          @relation("fk_eventreg_user")
  ewayBillsCreated                    EwayBill[]                   @relation("fk_ewaybills_creator")
  feedback                            Feedback[]                   @relation("fk_feedback_user")
  liveChatMessages                    LiveChatMessage[]            @relation("fk_chatmsg_sender")
  liveChats_fk_livechats_agent        LiveChat[]                   @relation("fk_livechats_agent")
  liveChats_fk_livechats_user         LiveChat[]                   @relation("fk_livechats_user")
  loginHistory                        LoginHistory[]               @relation("fk_loginhist_user")
  notificationSettings                NotificationSetting[]        @relation("fk_notifsettings_user")
  orderNotes                          OrderNote[]                  @relation("fk_ordernotes_author")
  orderStatusHistory                  OrderStatusHistory[]         @relation("fk_orderstatushist_user")
  otps                                Otp[]                        @relation("fk_otps_user")
  passwordResets                      PasswordReset[]              @relation("fk_pwreset_user")
  priceHistory                        PriceHistory[]               @relation("fk_pricehist_user")
  productionCheckpoints               ProductionCheckpoint[]       @relation("fk_prodcheckpoint_user")
  products                            Product[]                    @relation("fk_products_creator")
  quantityChangeRequestsDecided       QuantityChangeRequest[]      @relation("fk_qtychangereq_decider")
  quantityChangeRequestsMade          QuantityChangeRequest[]      @relation("fk_qtychangereq_requester")
  quotationStatusHistory              QuotationStatusHistory[]     @relation("fk_quotstatushist_user")
  recentActivity                      RecentActivity[]             @relation("fk_recentactivity_user")
  schoolDocuments                     SchoolDocument[]             @relation("fk_schooldocs_verifier")
  schools                             School[]                     @relation("fk_schools_user")
  sessions                            Session[]                    @relation("fk_sessions_user")
  shipmentAlternateRecipientApprovals Shipment[]                   @relation("fk_shipments_altrecipient_approver")
  supportTickets_fk_tickets_assignee  SupportTicket[]              @relation("fk_tickets_assignee")
  supportTickets_fk_tickets_raisedby  SupportTicket[]              @relation("fk_tickets_raisedby")
  ticketReplies                       TicketReply[]                @relation("fk_ticketreplies_author")
  uploadedFiles                       UploadedFile[]               @relation("fk_uploadedfiles_user")
  userRoles                           UserRole[]                   @relation("fk_ur_user")

  @@index([phone], map: "idx_users_phone")
  @@index([userType, status], map: "idx_users_type_status")
  @@map("users")
}

model UserRole {
  userId     BigInt   @map("user_id") @db.UnsignedBigInt
  roleId     BigInt   @map("role_id") @db.UnsignedBigInt
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamp(0)
  role       Role     @relation("fk_ur_role", fields: [roleId], references: [id], onDelete: Cascade, map: "fk_ur_role")
  user       User     @relation("fk_ur_user", fields: [userId], references: [id], onDelete: Cascade, map: "fk_ur_user")

  @@id([userId, roleId])
  @@index([roleId], map: "fk_ur_role")
  @@map("user_roles")
}

model Session {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid             String    @unique(map: "uq_sessions_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  userId           BigInt    @map("user_id") @db.UnsignedBigInt
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(0)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  user             User      @relation("fk_sessions_user", fields: [userId], references: [id], onDelete: Cascade, map: "fk_sessions_user")

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expires")
  @@map("sessions")
}

model PasswordReset {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(0)
  usedAt    DateTime? @map("used_at") @db.Timestamp(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  user      User      @relation("fk_pwreset_user", fields: [userId], references: [id], onDelete: Cascade, map: "fk_pwreset_user")

  @@index([userId], map: "idx_pwreset_user")
  @@index([tokenHash], map: "idx_pwreset_token")
  @@map("password_resets")
}

model Otp {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt?    @map("user_id") @db.UnsignedBigInt
  shipmentId   BigInt?    @map("shipment_id") @db.UnsignedBigInt
  identifier   String     @db.VarChar(190)
  otpHash      String     @map("otp_hash") @db.VarChar(255)
  purpose      OtpPurpose
  expiresAt    DateTime   @map("expires_at") @db.Timestamp(0)
  consumedAt   DateTime?  @map("consumed_at") @db.Timestamp(0)
  attemptCount Int        @default(0) @map("attempt_count") @db.UnsignedTinyInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  shipment     Shipment?  @relation("fk_otps_shipment", fields: [shipmentId], references: [id], onDelete: Cascade, map: "fk_otps_shipment")
  user         User?      @relation("fk_otps_user", fields: [userId], references: [id], onDelete: Cascade, map: "fk_otps_user")

  @@index([identifier, purpose], map: "idx_otps_identifier")
  @@index([shipmentId], map: "idx_otps_shipment")
  @@index([userId], map: "fk_otps_user")
  @@map("otps")
}

model LoginHistory {
  id        BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt             @map("user_id") @db.UnsignedBigInt
  ipAddress String?            @map("ip_address") @db.VarChar(45)
  userAgent String?            @map("user_agent") @db.VarChar(255)
  status    LoginHistoryStatus
  reason    String?            @db.VarChar(120)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  user      User               @relation("fk_loginhist_user", fields: [userId], references: [id], onDelete: Cascade, map: "fk_loginhist_user")

  @@index([userId, createdAt], map: "idx_loginhist_user_date")
  @@map("login_history")
}

model DeviceToken {
  id          BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt              @map("user_id") @db.UnsignedBigInt
  deviceToken String              @unique(map: "uq_device_token") @map("device_token") @db.VarChar(255)
  platform    DeviceTokenPlatform
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user        User                @relation("fk_devicetok_user", fields: [userId], references: [id], onDelete: Cascade, map: "fk_devicetok_user")
  pushQueue   PushQueue[]         @relation("fk_pushqueue_devicetoken")

  @@index([userId], map: "idx_devicetok_user")
  @@map("device_tokens")
}

model School {
  id                    BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                  String                 @unique(map: "uq_schools_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  userId                BigInt                 @map("user_id") @db.UnsignedBigInt
  schoolName            String                 @map("school_name") @db.VarChar(200)
  schoolCode            String                 @unique(map: "uq_schools_code") @map("school_code") @db.VarChar(30)
  schoolType            SchoolSchoolType       @default(preschool) @map("school_type")
  boardAffiliation      String?                @map("board_affiliation") @db.VarChar(80)
  registrationNumber    String?                @map("registration_number") @db.VarChar(80)
  gstin                 String?                @db.VarChar(15)
  status                SchoolStatus           @default(pending_approval)
  logoFileId            BigInt?                @map("logo_file_id") @db.UnsignedBigInt
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamp(0)
  branches              Branch[]               @relation("fk_branches_school")
  certificates          Certificate[]          @relation("fk_certificates_school")
  couponUsage           CouponUsage[]          @relation("fk_couponusage_school")
  customizationRequests CustomizationRequest[] @relation("fk_customreq_school")
  dealerRatings         DealerRating[]         @relation("fk_dealerratings_school")
  eventRegistrations    EventRegistration[]    @relation("fk_eventreg_school")
  idCards               IdCard[]               @relation("fk_idcards_school")
  invoices              Invoice[]              @relation("fk_invoices_school")
  orders                Order[]                @relation("fk_orders_school")
  paymentMethods        PaymentMethod[]        @relation("fk_paymethods_school")
  payments              Payment[]              @relation("fk_payments_school")
  printingServices      PrintingService[]      @relation("fk_printing_school")
  quotationComparisons  QuotationComparison[]  @relation("fk_quotcompare_school")
  quotationRequests     QuotationRequest[]     @relation("fk_quotreq_school")
  recentlyViewed        RecentlyViewed[]       @relation("fk_recentview_school")
  rewardPoints          RewardPoint?           @relation("fk_rewardpoints_school")
  schoolAddresses       SchoolAddress[]        @relation("fk_schooladdr_school")
  schoolDocuments       SchoolDocument[]       @relation("fk_schooldocs_school")
  schoolProfiles        SchoolProfile?         @relation("fk_schoolprofile_school")
  schoolSettings        SchoolSetting[]        @relation("fk_schoolsettings_school")
  logoFile              UploadedFile?          @relation("fk_school_logofileid", fields: [logoFileId], references: [id], map: "fk_schools_logo")
  user                  User                   @relation("fk_schools_user", fields: [userId], references: [id], map: "fk_schools_user")
  shoppingCarts         ShoppingCart[]         @relation("fk_carts_school")
  subscriptions         Subscription[]         @relation("fk_subs_school")
  successStories        SuccessStory[]         @relation("fk_successstories_school")
  supportTickets        SupportTicket[]        @relation("fk_tickets_school")
  uniformDesigns        UniformDesign[]        @relation("fk_uniform_school")
  wallets               Wallet?                @relation("fk_wallets_school")
  websiteServices       WebsiteService[]       @relation("fk_website_school")
  wishlists             Wishlist[]             @relation("fk_wishlists_school")

  @@index([userId], map: "idx_schools_user")
  @@index([status], map: "idx_schools_status")
  @@index([logoFileId], map: "fk_schools_logo")
  @@map("schools")
}

model SchoolProfile {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  schoolId        BigInt   @unique(map: "uq_school_profile_school") @map("school_id") @db.UnsignedBigInt
  establishedYear Int?     @map("established_year") @db.Year
  websiteUrl      String?  @map("website_url") @db.VarChar(255)
  contactEmail    String?  @map("contact_email") @db.VarChar(190)
  contactPhone    String?  @map("contact_phone") @db.VarChar(20)
  altPhone        String?  @map("alt_phone") @db.VarChar(20)
  about           String?  @db.Text
  studentCount    Int?     @map("student_count") @db.UnsignedInt
  teacherCount    Int?     @map("teacher_count") @db.UnsignedInt
  branchCount     Int      @default(1) @map("branch_count") @db.UnsignedInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  school          School   @relation("fk_schoolprofile_school", fields: [schoolId], references: [id], onDelete: Cascade, map: "fk_schoolprofile_school")

  @@map("school_profiles")
}

model SchoolAddress {
  id                        BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  schoolId                  BigInt                   @map("school_id") @db.UnsignedBigInt
  addressType               SchoolAddressAddressType @default(registered) @map("address_type")
  addressLine1              String                   @map("address_line1") @db.VarChar(255)
  addressLine2              String?                  @map("address_line2") @db.VarChar(255)
  city                      String                   @db.VarChar(100)
  state                     String                   @db.VarChar(100)
  country                   String                   @default("India") @db.VarChar(100)
  pincode                   String                   @db.VarChar(12)
  latitude                  Decimal?                 @db.Decimal(10, 7)
  longitude                 Decimal?                 @db.Decimal(10, 7)
  isDefault                 Boolean                  @default(false) @map("is_default")
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                 DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  branches                  Branch[]                 @relation("fk_branches_address")
  orders_fk_orders_billaddr Order[]                  @relation("fk_orders_billaddr")
  orders_fk_orders_shipaddr Order[]                  @relation("fk_orders_shipaddr")
  school                    School                   @relation("fk_schooladdr_school", fields: [schoolId], references: [id], onDelete: Cascade, map: "fk_schooladdr_school")

  @@index([schoolId], map: "idx_school_addr_school")
  @@index([pincode], map: "idx_school_addr_pincode")
  @@map("school_addresses")
}

model Branch {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String         @default(dbgenerated("(uuid())")) @db.Char(36)
  schoolId      BigInt         @map("school_id") @db.UnsignedBigInt
  branchName    String         @map("branch_name") @db.VarChar(150)
  branchCode    String         @map("branch_code") @db.VarChar(30)
  addressId     BigInt?        @map("address_id") @db.UnsignedBigInt
  contactPhone  String?        @map("contact_phone") @db.VarChar(20)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamp(0)
  schoolAddress SchoolAddress? @relation("fk_branches_address", fields: [addressId], references: [id], map: "fk_branches_address")
  school        School         @relation("fk_branches_school", fields: [schoolId], references: [id], onDelete: Cascade, map: "fk_branches_school")

  @@unique([schoolId, branchCode], map: "uq_branch_code")
  @@index([schoolId], map: "idx_branches_school")
  @@index([addressId], map: "fk_branches_address")
  @@map("branches")
}

model SchoolDocument {
  id           BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  schoolId     BigInt                     @map("school_id") @db.UnsignedBigInt
  documentType SchoolDocumentDocumentType @map("document_type")
  fileId       BigInt                     @map("file_id") @db.UnsignedBigInt
  verified     Boolean                    @default(false)
  verifiedAt   DateTime?                  @map("verified_at") @db.Timestamp(0)
  verifiedBy   BigInt?                    @map("verified_by") @db.UnsignedBigInt
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamp(0)
  uploadedFile UploadedFile               @relation("fk_schooldocument_file", fields: [fileId], references: [id], map: "fk_schooldocs_file")
  school       School                     @relation("fk_schooldocs_school", fields: [schoolId], references: [id], onDelete: Cascade, map: "fk_schooldocs_school")
  user         User?                      @relation("fk_schooldocs_verifier", fields: [verifiedBy], references: [id], map: "fk_schooldocs_verifier")

  @@index([schoolId], map: "idx_schooldocs_school")
  @@index([fileId], map: "fk_schooldocs_file")
  @@index([verifiedBy], map: "fk_schooldocs_verifier")
  @@map("school_documents")
}

model Dealer {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  uuid               String               @unique(map: "uq_dealers_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  userId             BigInt               @map("user_id") @db.UnsignedBigInt
  businessName       String               @map("business_name") @db.VarChar(200)
  dealerCode         String               @unique(map: "uq_dealers_code") @map("dealer_code") @db.VarChar(30)
  gstin              String?              @db.VarChar(15)
  panNumber          String?              @map("pan_number") @db.VarChar(10)
  businessType       DealerBusinessType   @default(distributor) @map("business_type")
  status             DealerStatus         @default(pending_approval)
  commissionRate     Decimal              @default(0.00) @map("commission_rate") @db.Decimal(5, 2)
  averageRating      Decimal              @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  logoFileId         BigInt?              @map("logo_file_id") @db.UnsignedBigInt
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamp(0)
  cartItems          CartItem[]           @relation("fk_cartitems_dealer")
  dealerAddresses    DealerAddress[]      @relation("fk_dealeraddr_dealer")
  dealerAvailability DealerAvailability[] @relation("fk_dealeravail_dealer")
  dealerDocuments    DealerDocument[]     @relation("fk_dealerdocs_dealer")
  dealerProducts     DealerProduct[]      @relation("fk_dealerprod_dealer")
  dealerQuotations   DealerQuotation[]    @relation("fk_dealerquot_dealer")
  dealerRatings      DealerRating[]       @relation("fk_dealerratings_dealer")
  dealerSettings     DealerSetting[]      @relation("fk_dealersettings_dealer")
  logoFile           UploadedFile?        @relation("fk_dealer_logofileid", fields: [logoFileId], references: [id], map: "fk_dealers_logo")
  user               User                 @relation("fk_dealers_user", fields: [userId], references: [id], map: "fk_dealers_user")
  inventory          Inventory[]          @relation("fk_inventory_dealer")
  orders             Order[]              @relation("fk_orders_dealer")
  supportTickets     SupportTicket[]      @relation("fk_tickets_dealer")

  @@index([userId], map: "idx_dealers_user")
  @@index([status], map: "idx_dealers_status")
  @@index([logoFileId], map: "fk_dealers_logo")
  @@map("dealers")
}

model DealerAddress {
  id           BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  dealerId     BigInt                   @map("dealer_id") @db.UnsignedBigInt
  addressType  DealerAddressAddressType @default(registered) @map("address_type")
  addressLine1 String                   @map("address_line1") @db.VarChar(255)
  addressLine2 String?                  @map("address_line2") @db.VarChar(255)
  city         String                   @db.VarChar(100)
  state        String                   @db.VarChar(100)
  country      String                   @default("India") @db.VarChar(100)
  pincode      String                   @db.VarChar(12)
  latitude     Decimal?                 @db.Decimal(10, 7)
  longitude    Decimal?                 @db.Decimal(10, 7)
  isDefault    Boolean                  @default(false) @map("is_default")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamp(0)
  dealer       Dealer                   @relation("fk_dealeraddr_dealer", fields: [dealerId], references: [id], onDelete: Cascade, map: "fk_dealeraddr_dealer")

  @@index([dealerId], map: "idx_dealer_addr_dealer")
  @@index([pincode], map: "idx_dealer_addr_pincode")
  @@map("dealer_addresses")
}

model DealerProduct {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  dealerId    BigInt   @map("dealer_id") @db.UnsignedBigInt
  productId   BigInt   @map("product_id") @db.UnsignedBigInt
  dealerSku   String?  @map("dealer_sku") @db.VarChar(60)
  dealerPrice Decimal  @map("dealer_price") @db.Decimal(12, 2)
  stockQty    Int      @default(0) @map("stock_qty") @db.UnsignedInt
  isActive    Boolean  @default(true) @map("is_active")
