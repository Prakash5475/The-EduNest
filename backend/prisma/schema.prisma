  customizationRequestId BigInt               @map("customization_request_id") @db.UnsignedBigInt
  status                 String               @db.VarChar(30)
  changedBy              BigInt?              @map("changed_by") @db.UnsignedBigInt
  note                   String?              @db.VarChar(255)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  customizationRequest   CustomizationRequest @relation("fk_customstatushist_request", fields: [customizationRequestId], references: [id], onDelete: Cascade, map: "fk_customstatushist_request")
  user                   User?                @relation("fk_customstatushist_user", fields: [changedBy], references: [id], map: "fk_customstatushist_user")

  @@index([customizationRequestId, createdAt], map: "idx_customstatushist_request")
  @@index([changedBy], map: "fk_customstatushist_user")
  @@map("customization_status_history")
}

model ShippingMethod {
  id               BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name             String  @unique(map: "uq_shippingmethods_name") @db.VarChar(60)
  rate             Decimal @default(0.00) @db.Decimal(12, 2)
  estimatedDaysMin Int     @map("estimated_days_min") @db.UnsignedSmallInt
  estimatedDaysMax Int     @map("estimated_days_max") @db.UnsignedSmallInt
  isActive         Boolean @default(true) @map("is_active")
  orders           Order[] @relation("fk_orders_shipmethod")

  @@map("shipping_methods")
}

model Order {
  id                    BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                  String                 @unique(map: "uq_orders_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  orderNumber           String                 @unique(map: "uq_orders_number") @map("order_number") @db.VarChar(30)
  schoolId              BigInt                 @map("school_id") @db.UnsignedBigInt
  dealerId              BigInt?                @map("dealer_id") @db.UnsignedBigInt
  billingAddressId      BigInt?                @map("billing_address_id") @db.UnsignedBigInt
  shippingAddressId     BigInt?                @map("shipping_address_id") @db.UnsignedBigInt
  shippingMethodId      BigInt?                @map("shipping_method_id") @db.UnsignedBigInt
  subtotal              Decimal                @default(0.00) @db.Decimal(12, 2)
  taxAmount             Decimal                @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount        Decimal                @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  shippingAmount        Decimal                @default(0.00) @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount           Decimal                @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  dealerTotalAmount     Decimal                @default(0.00) @map("dealer_total_amount") @db.Decimal(12, 2)
  marginAmount          Decimal                @default(0.00) @map("margin_amount") @db.Decimal(12, 2)
  platformFeeAmount     Decimal                @default(0.00) @map("platform_fee_amount") @db.Decimal(12, 2)
  netRevenueAmount      Decimal                @default(0.00) @map("net_revenue_amount") @db.Decimal(12, 2)
  currency              String                 @default("INR") @db.Char(3)
  status                OrderStatus            @default(pending)
  paymentStatus         OrderPaymentStatus     @default(unpaid) @map("payment_status")
  productionDeadline    DateTime?              @map("production_deadline") @db.Date
  expectedDeliveryDate  DateTime?              @map("expected_delivery_date") @db.Date
  priority              OrderPriority          @default(normal)
  placedAt              DateTime               @default(now()) @map("placed_at") @db.Timestamp(0)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamp(0)
  acceptedQuotations    AcceptedQuotation[]    @relation("fk_acceptedquot_order")
  cancellations         Cancellation?          @relation("fk_cancellations_order")
  couponUsage           CouponUsage[]          @relation("fk_couponusage_order")
  deliveryUpdates       DeliveryUpdate[]       @relation("fk_deliveryupdates_order")
  ewayBills             EwayBill[]             @relation("fk_ewaybills_order")
  invoices              Invoice[]              @relation("fk_invoices_order")
  orderItems            OrderItem[]            @relation("fk_orderitems_order")
  orderNotes            OrderNote[]            @relation("fk_ordernotes_order")
  orderStatusHistory    OrderStatusHistory[]   @relation("fk_orderstatushist_order")
  orderTimeline         OrderTimeline[]        @relation("fk_ordertimeline_order")
  schoolAddress         SchoolAddress?         @relation("fk_orders_billaddr", fields: [billingAddressId], references: [id], map: "fk_orders_billaddr")
  dealer                Dealer?                @relation("fk_orders_dealer", fields: [dealerId], references: [id], map: "fk_orders_dealer")
  school                School                 @relation("fk_orders_school", fields: [schoolId], references: [id], map: "fk_orders_school")
  schoolAddressRef      SchoolAddress?         @relation("fk_orders_shipaddr", fields: [shippingAddressId], references: [id], map: "fk_orders_shipaddr")
  shippingMethod        ShippingMethod?        @relation("fk_orders_shipmethod", fields: [shippingMethodId], references: [id], map: "fk_orders_shipmethod")
  payments              Payment[]              @relation("fk_payments_order")
  productionCheckpoints ProductionCheckpoint[] @relation("fk_prodcheckpoint_order")
  refunds               Refund[]               @relation("fk_refunds_order")
  returns               Return[]               @relation("fk_returns_order")
  shipments             Shipment[]             @relation("fk_shipments_order")

  @@index([schoolId, status], map: "idx_orders_school")
  @@index([dealerId, status], map: "idx_orders_dealer")
  @@index([placedAt], map: "idx_orders_placed")
  @@index([billingAddressId], map: "fk_orders_billaddr")
  @@index([shippingAddressId], map: "fk_orders_shipaddr")
  @@index([shippingMethodId], map: "fk_orders_shipmethod")
  @@map("orders")
}

model OrderItem {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  orderId          BigInt            @map("order_id") @db.UnsignedBigInt
  itemType         OrderItemItemType @default(product) @map("item_type")
  productId        BigInt?           @map("product_id") @db.UnsignedBigInt
  variantId        BigInt?           @map("variant_id") @db.UnsignedBigInt
  kitId            BigInt?           @map("kit_id") @db.UnsignedBigInt
  itemNameSnapshot String            @map("item_name_snapshot") @db.VarChar(220)
  quantity         Int               @db.UnsignedInt
  unitPrice        Decimal           @map("unit_price") @db.Decimal(12, 2)
  dealerUnitPrice  Decimal           @default(0.00) @map("dealer_unit_price") @db.Decimal(12, 2)
  taxAmount        Decimal           @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal        Decimal           @map("line_total") @db.Decimal(12, 2)
  invoiceItems     InvoiceItem[]     @relation("fk_invoiceitems_orderitem")
  kit              Kit?              @relation("fk_orderitems_kit", fields: [kitId], references: [id], map: "fk_orderitems_kit")
  order            Order             @relation("fk_orderitems_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_orderitems_order")
  product          Product?          @relation("fk_orderitems_product", fields: [productId], references: [id], map: "fk_orderitems_product")
  productVariant   ProductVariant?   @relation("fk_orderitems_variant", fields: [variantId], references: [id], map: "fk_orderitems_variant")
  returns          Return[]          @relation("fk_returns_orderitem")

  @@index([orderId], map: "idx_orderitems_order")
  @@index([productId], map: "idx_orderitems_product")
  @@index([kitId], map: "fk_orderitems_kit")
  @@index([variantId], map: "fk_orderitems_variant")
  @@map("order_items")
}

model OrderStatusHistory {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId   BigInt   @map("order_id") @db.UnsignedBigInt
  status    String   @db.VarChar(30)
  changedBy BigInt?  @map("changed_by") @db.UnsignedBigInt
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  order     Order    @relation("fk_orderstatushist_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_orderstatushist_order")
  user      User?    @relation("fk_orderstatushist_user", fields: [changedBy], references: [id], map: "fk_orderstatushist_user")

  @@index([orderId, createdAt], map: "idx_orderstatushist_order")
  @@index([changedBy], map: "fk_orderstatushist_user")
  @@map("order_status_history")
}

model OrderTimeline {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId          BigInt   @map("order_id") @db.UnsignedBigInt
  eventType        String   @map("event_type") @db.VarChar(60)
  eventDescription String?  @map("event_description") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  order            Order    @relation("fk_ordertimeline_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_ordertimeline_order")

  @@index([orderId, createdAt], map: "idx_ordertimeline_order")
  @@map("order_timeline")
}

model OrderNote {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId    BigInt   @map("order_id") @db.UnsignedBigInt
  authorId   BigInt?  @map("author_id") @db.UnsignedBigInt
  note       String   @db.Text
  isInternal Boolean  @default(true) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  user       User?    @relation("fk_ordernotes_author", fields: [authorId], references: [id], map: "fk_ordernotes_author")
  order      Order    @relation("fk_ordernotes_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_ordernotes_order")

  @@index([orderId], map: "idx_ordernotes_order")
  @@index([authorId], map: "fk_ordernotes_author")
  @@map("order_notes")
}

model ProductionCheckpoint {
  id                         BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  orderId                    BigInt                            @map("order_id") @db.UnsignedBigInt
  stage                      ProductionCheckpointStage
  completionPercentage       Int                               @default(0) @map("completion_percentage") @db.UnsignedTinyInt
  notes                      String?                           @db.Text
  updatedBy                  BigInt?                           @map("updated_by") @db.UnsignedBigInt
  updatedByType              ProductionCheckpointUpdatedByType @default(system) @map("updated_by_type")
  overrideReason             String?                           @map("override_reason") @db.VarChar(500)
  createdAt                  DateTime                          @default(now()) @map("created_at") @db.Timestamp(0)
  productionCheckpointImages ProductionCheckpointImage[]       @relation("fk_prodcheckpointimg_checkpoint")
  order                      Order                             @relation("fk_prodcheckpoint_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_prodcheckpoint_order")
  user                       User?                             @relation("fk_prodcheckpoint_user", fields: [updatedBy], references: [id], map: "fk_prodcheckpoint_user")

  @@index([orderId, createdAt], map: "idx_prodcheckpoint_order")
  @@index([updatedBy], map: "fk_prodcheckpoint_user")
  @@map("production_checkpoints")
}

model ProductionCheckpointImage {
  id                     BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  productionCheckpointId BigInt               @map("production_checkpoint_id") @db.UnsignedBigInt
  fileId                 BigInt               @map("file_id") @db.UnsignedBigInt
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  productionCheckpoint   ProductionCheckpoint @relation("fk_prodcheckpointimg_checkpoint", fields: [productionCheckpointId], references: [id], onDelete: Cascade, map: "fk_prodcheckpointimg_checkpoint")
  uploadedFile           UploadedFile         @relation("fk_productioncheckpointimage_file", fields: [fileId], references: [id], onDelete: Cascade, map: "fk_prodcheckpointimg_file")

  @@index([productionCheckpointId], map: "idx_prodcheckpointimg_checkpoint")
  @@index([fileId], map: "fk_prodcheckpointimg_file")
  @@map("production_checkpoint_images")
}

model Return {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  uuid        String       @default(dbgenerated("(uuid())")) @db.Char(36)
  orderId     BigInt       @map("order_id") @db.UnsignedBigInt
  orderItemId BigInt       @map("order_item_id") @db.UnsignedBigInt
  quantity    Int          @db.UnsignedInt
  reason      String       @db.VarChar(255)
  status      ReturnStatus @default(requested)
  requestedAt DateTime     @default(now()) @map("requested_at") @db.Timestamp(0)
  resolvedAt  DateTime?    @map("resolved_at") @db.Timestamp(0)
  refunds     Refund[]     @relation("fk_refunds_return")
  order       Order        @relation("fk_returns_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_returns_order")
  orderItem   OrderItem    @relation("fk_returns_orderitem", fields: [orderItemId], references: [id], onDelete: Cascade, map: "fk_returns_orderitem")

  @@index([orderId], map: "idx_returns_order")
  @@index([orderItemId], map: "fk_returns_orderitem")
  @@map("returns")
}

model Cancellation {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId     BigInt   @unique(map: "uq_cancellations_order") @map("order_id") @db.UnsignedBigInt
  cancelledBy BigInt?  @map("cancelled_by") @db.UnsignedBigInt
  reason      String   @db.VarChar(255)
  cancelledAt DateTime @default(now()) @map("cancelled_at") @db.Timestamp(0)
  order       Order    @relation("fk_cancellations_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_cancellations_order")
  user        User?    @relation("fk_cancellations_user", fields: [cancelledBy], references: [id], map: "fk_cancellations_user")

  @@index([cancelledBy], map: "fk_cancellations_user")
  @@map("cancellations")
}

model Refund {
  id           BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  uuid         String             @default(dbgenerated("(uuid())")) @db.Char(36)
  orderId      BigInt             @map("order_id") @db.UnsignedBigInt
  returnId     BigInt?            @map("return_id") @db.UnsignedBigInt
  amount       Decimal            @db.Decimal(12, 2)
  refundMethod RefundRefundMethod @default(original_payment) @map("refund_method")
  status       RefundStatus       @default(initiated)
  processedAt  DateTime?          @map("processed_at") @db.Timestamp(0)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  order        Order              @relation("fk_refunds_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_refunds_order")
  return       Return?            @relation("fk_refunds_return", fields: [returnId], references: [id], map: "fk_refunds_return")

  @@index([orderId], map: "idx_refunds_order")
  @@index([returnId], map: "fk_refunds_return")
  @@map("refunds")
}

model Invoice {
  id            BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String             @default(dbgenerated("(uuid())")) @db.Char(36)
  invoiceNumber String             @unique(map: "uq_invoices_number") @map("invoice_number") @db.VarChar(30)
  orderId       BigInt             @map("order_id") @db.UnsignedBigInt
  schoolId      BigInt             @map("school_id") @db.UnsignedBigInt
  subtotal      Decimal            @db.Decimal(12, 2)
  taxAmount     Decimal            @map("tax_amount") @db.Decimal(12, 2)
  cgstAmount    Decimal            @default(0.00) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount    Decimal            @default(0.00) @map("sgst_amount") @db.Decimal(12, 2)
  utgstAmount   Decimal            @default(0.00) @map("utgst_amount") @db.Decimal(12, 2)
  igstAmount    Decimal            @default(0.00) @map("igst_amount") @db.Decimal(12, 2)
  isInterState  Boolean            @default(false) @map("is_inter_state")
  placeOfSupply String?            @map("place_of_supply") @db.VarChar(100)
  sellerGstin   String?            @map("seller_gstin") @db.VarChar(15)
  buyerGstin    String?            @map("buyer_gstin") @db.VarChar(15)
  totalAmount   Decimal            @map("total_amount") @db.Decimal(12, 2)
  fileId        BigInt?            @map("file_id") @db.UnsignedBigInt
  invoiceType   InvoiceInvoiceType @default(final_invoice) @map("invoice_type")
  issuedAt      DateTime           @default(now()) @map("issued_at") @db.Timestamp(0)
  dueDate       DateTime?          @map("due_date") @db.Date
  status        InvoiceStatus      @default(issued)
  ewayBills     EwayBill[]         @relation("fk_ewaybills_invoice")
  invoiceItems  InvoiceItem[]      @relation("fk_invoiceitems_invoice")
  uploadedFile  UploadedFile?      @relation("fk_invoice_file", fields: [fileId], references: [id], map: "fk_invoices_file")
  order         Order              @relation("fk_invoices_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_invoices_order")
  school        School             @relation("fk_invoices_school", fields: [schoolId], references: [id], map: "fk_invoices_school")

  @@index([orderId], map: "idx_invoices_order")
  @@index([schoolId], map: "idx_invoices_school")
  @@index([fileId], map: "fk_invoices_file")
  @@map("invoices")
}

model InvoiceItem {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  invoiceId   BigInt    @map("invoice_id") @db.UnsignedBigInt
  orderItemId BigInt    @map("order_item_id") @db.UnsignedBigInt
  description String    @db.VarChar(255)
  quantity    Int       @db.UnsignedInt
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  taxRate     Decimal   @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   Decimal   @map("line_total") @db.Decimal(12, 2)
  invoice     Invoice   @relation("fk_invoiceitems_invoice", fields: [invoiceId], references: [id], onDelete: Cascade, map: "fk_invoiceitems_invoice")
  orderItem   OrderItem @relation("fk_invoiceitems_orderitem", fields: [orderItemId], references: [id], onDelete: Cascade, map: "fk_invoiceitems_orderitem")

  @@index([invoiceId], map: "idx_invoiceitems_invoice")
  @@index([orderItemId], map: "fk_invoiceitems_orderitem")
  @@map("invoice_items")
}

/// *
///  * Record-keeping only — see the matching comment in edunest_database_schema.sql.
///  * ewayBillNumber is filled in manually after generating it on the government e-way bill
///  * portal; nothing in this codebase calls a government/IRP API to generate one.
model EwayBill {
  id               BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  uuid             String                @default(dbgenerated("(uuid())")) @db.Char(36)
  orderId          BigInt                @map("order_id") @db.UnsignedBigInt
  invoiceId        BigInt?               @map("invoice_id") @db.UnsignedBigInt
  ewayBillNumber   String?               @unique(map: "uq_ewaybills_number") @map("eway_bill_number") @db.VarChar(20)
  transporterName  String?               @map("transporter_name") @db.VarChar(150)
  transporterGstin String?               @map("transporter_gstin") @db.VarChar(15)
  transportMode    EwayBillTransportMode @default(road) @map("transport_mode")
  vehicleNumber    String?               @map("vehicle_number") @db.VarChar(20)
  distanceKm       Int?                  @map("distance_km") @db.UnsignedInt
  status           EwayBillStatus        @default(draft)
  validFrom        DateTime?             @map("valid_from") @db.Timestamp(0)
  validUntil       DateTime?             @map("valid_until") @db.Timestamp(0)
  createdBy        BigInt?               @map("created_by") @db.UnsignedBigInt
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  creator          User?                 @relation("fk_ewaybills_creator", fields: [createdBy], references: [id], map: "fk_ewaybills_creator")
  invoice          Invoice?              @relation("fk_ewaybills_invoice", fields: [invoiceId], references: [id], map: "fk_ewaybills_invoice")
  order            Order                 @relation("fk_ewaybills_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_ewaybills_order")

  @@index([orderId], map: "idx_ewaybills_order")
  @@index([createdBy], map: "fk_ewaybills_creator")
  @@index([invoiceId], map: "fk_ewaybills_invoice")
  @@map("eway_bills")
}

model DeliveryPartner {
  id                 BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  uuid               String                            @default(dbgenerated("(uuid())")) @db.Char(36)
  fullName           String                            @map("full_name") @db.VarChar(150)
  mobile             String                            @unique(map: "uq_deliverypartners_mobile") @db.VarChar(20)
  email              String?                           @db.VarChar(190)
  address            String?                           @db.VarChar(255)
  city               String?                           @db.VarChar(100)
  state              String?                           @db.VarChar(100)
  pincode            String?                           @db.VarChar(10)
  vehicleType        String?                           @map("vehicle_type") @db.VarChar(50)
  vehicleNumber      String?                           @map("vehicle_number") @db.VarChar(30)
  availabilityStatus DeliveryPartnerAvailabilityStatus @default(available) @map("availability_status")
  status             DeliveryPartnerStatus             @default(active)
  joiningDate        DateTime?                         @map("joining_date") @db.Date
  notes              String?                           @db.Text
  createdAt          DateTime                          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime                          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt          DateTime?                         @map("deleted_at") @db.Timestamp(0)
  shipments          Shipment[]                        @relation("fk_shipments_deliverypartner")

  @@index([status, availabilityStatus], map: "idx_deliverypartners_status")
  @@map("delivery_partners")
}

model Shipment {
  id                           BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                         String           @default(dbgenerated("(uuid())")) @db.Char(36)
  orderId                      BigInt           @map("order_id") @db.UnsignedBigInt
  carrierName                  String?          @map("carrier_name") @db.VarChar(100)
  trackingNumber               String?          @map("tracking_number") @db.VarChar(100)
  deliveryPartnerId            BigInt?          @map("delivery_partner_id") @db.UnsignedBigInt
  status                       ShipmentStatus   @default(pending)
  recipientName                String?          @map("recipient_name") @db.VarChar(150)
  recipientPhone               String?          @map("recipient_phone") @db.VarChar(20)
  alternateRecipientApprovedBy BigInt?          @map("alternate_recipient_approved_by") @db.UnsignedBigInt
  shippedAt                    DateTime?        @map("shipped_at") @db.Timestamp(0)
  deliveredAt                  DateTime?        @map("delivered_at") @db.Timestamp(0)
  createdAt                    DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  deliveryUpdates              DeliveryUpdate[] @relation("fk_deliveryupdates_shipment")
  otps                         Otp[]            @relation("fk_otps_shipment")
  alternateRecipientApprover   User?            @relation("fk_shipments_altrecipient_approver", fields: [alternateRecipientApprovedBy], references: [id], map: "fk_shipments_altrecipient_approver")
  deliveryPartner              DeliveryPartner? @relation("fk_shipments_deliverypartner", fields: [deliveryPartnerId], references: [id], map: "fk_shipments_deliverypartner")
  order                        Order            @relation("fk_shipments_order", fields: [orderId], references: [id], onDelete: Cascade, map: "fk_shipments_order")
  tracking                     Tracking[]       @relation("fk_tracking_shipment")

  @@index([orderId], map: "idx_shipments_order")
  @@index([trackingNumber], map: "idx_shipments_tracking")
  @@index([deliveryPartnerId, status], map: "idx_shipments_deliverypartner")
  @@index([alternateRecipientApprovedBy], map: "fk_shipments_altrecipient_approver")
  @@map("shipments")
}

model Tracking {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  shipmentId BigInt   @map("shipment_id") @db.UnsignedBigInt
  location   String?  @db.VarChar(200)
  statusText String   @map("status_text") @db.VarChar(255)
