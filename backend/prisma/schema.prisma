model ThemeSetting {
  id          BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  scopeType   ThemeSettingScopeType @default(platform) @map("scope_type")
  scopeId     BigInt?               @map("scope_id") @db.UnsignedBigInt
  configKey   String                @map("config_key") @db.VarChar(100)
  configValue String?               @map("config_value") @db.Text

  @@unique([scopeType, scopeId, configKey], map: "uq_themesettings")
  @@map("theme_settings")
