  user                          User?                           @relation("fk_uploadedfiles_user", fields: [uploadedBy], references: [id], map: "fk_uploadedfiles_user")
  worksheets                    Worksheet[]                     @relation("fk_worksheet_file")

  @@index([uploadedBy], map: "idx_uploadedfiles_uploader")
  @@map("uploaded_files")
}

model Media {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  fileId          BigInt         @map("file_id") @db.UnsignedBigInt
  mediaType       MediaMediaType @map("media_type")
  widthPx         Int?           @map("width_px") @db.UnsignedInt
  heightPx        Int?           @map("height_px") @db.UnsignedInt
  durationSeconds Int?           @map("duration_seconds") @db.UnsignedInt
  uploadedFile    UploadedFile   @relation("fk_media_file", fields: [fileId], references: [id], onDelete: Cascade, map: "fk_media_file")

  @@index([fileId], map: "idx_media_file")
  @@map("media")
}

model Document {
  id               BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  fileId           BigInt       @map("file_id") @db.UnsignedBigInt
  documentCategory String?      @map("document_category") @db.VarChar(80)
  uploadedFile     UploadedFile @relation("fk_documents_file", fields: [fileId], references: [id], onDelete: Cascade, map: "fk_documents_file")

  @@index([fileId], map: "idx_documents_file")
  @@map("documents")
}

model Attachment {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  fileId         BigInt       @map("file_id") @db.UnsignedBigInt
  attachableType String       @map("attachable_type") @db.VarChar(60)
  attachableId   BigInt       @map("attachable_id") @db.UnsignedBigInt
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  uploadedFile   UploadedFile @relation("fk_attachments_file", fields: [fileId], references: [id], onDelete: Cascade, map: "fk_attachments_file")

  @@index([attachableType, attachableId], map: "idx_attachments_polymorphic")
  @@index([fileId], map: "fk_attachments_file")
  @@map("attachments")
}

model ApplicationSetting {
  id           BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
