enum WhatsappMessageStatus {
  queued
  processing
  sent
  delivered
  read
  failed
}

/// Delivery-tracking record for every WhatsApp notification attempt. `notificationId` /
/// `notificationCreatedAt` point at the Notification row (composite PK) that is the system of
/// record; this table is purely the WhatsApp-channel delivery ledger on top of it.
model WhatsappMessageLog {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  notificationId BigInt? @map("notification_id") @db.UnsignedBigInt
  notificationCreatedAt DateTime? @map("notification_created_at")
  userId BigInt @map("user_id") @db.UnsignedBigInt
  phone String @db.VarChar(20)
  eventType String @map("event_type") @db.VarChar(60)
  templateName String @map("template_name") @db.VarChar(100)
  templateParams Json @map("template_params")
  bodyPreview String? @map("body_preview") @db.VarChar(500)
  status WhatsappMessageStatus
  providerName String @map("provider_name") @db.VarChar(40)
  providerMessageId String? @map("provider_message_id") @db.VarChar(150)
  providerResponse Json? @map("provider_response")
  errorMessage String? @map("error_message") @db.VarChar(500)
  retryCount Int @default(0) @map("retry_count") @db.UnsignedTinyInt
  queuedAt DateTime @default(now()) @map("queued_at")
  sentAt DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt DateTime? @map("read_at")
  failedAt DateTime? @map("failed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation("fk_whatsapplog_user", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([userId, createdAt], map: "idx_whatsapplog_user")
  @@index([status], map: "idx_whatsapplog_status")
  @@map("whatsapp_message_logs")
}

