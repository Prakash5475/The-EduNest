model AuditLog {
  id         BigInt   @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt?  @map("user_id") @db.UnsignedBigInt
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   BigInt   @map("entity_id") @db.UnsignedBigInt
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@id([id, createdAt])
  @@index([entityType, entityId], map: "idx_auditlogs_entity")
  @@index([userId, createdAt], map: "idx_auditlogs_user")
  @@map("audit_logs")
}

model ActivityLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt?  @map("user_id") @db.UnsignedBigInt
  activity  String   @db.VarChar(150)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  user      User?    @relation("fk_activitylogs_user", fields: [userId], references: [id], map: "fk_activitylogs_user")

  @@index([userId, createdAt], map: "idx_activitylogs_user")
  @@map("activity_logs")
}

model ErrorLog {
  id         BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  errorLevel ErrorLogErrorLevel @default(error) @map("error_level")
  message    String             @db.Text
  stackTrace String?            @map("stack_trace") @db.MediumText
  context    Json?
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([errorLevel, createdAt], map: "idx_errorlogs_level_date")
  @@map("error_logs")
}

model ApiLog {
  id             BigInt   @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt?  @map("user_id") @db.UnsignedBigInt
  method         String   @db.VarChar(10)
  endpoint       String   @db.VarChar(255)
  statusCode     Int      @map("status_code") @db.UnsignedSmallInt
  responseTimeMs Int?     @map("response_time_ms") @db.UnsignedInt
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@id([id, createdAt])
  @@index([endpoint, createdAt], map: "idx_apilogs_endpoint")
  @@index([userId], map: "idx_apilogs_user")
  @@map("api_logs")
}

