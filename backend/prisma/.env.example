# Only DATABASE_URL is needed here — Prisma CLI (generate/migrate/studio) resolves its
# .env from the same directory as schema.prisma when one exists, taking priority over the
# project-root backend/.env that the actual Node app loads at runtime. Keeping this file to
# just DATABASE_URL (instead of a full duplicate of every secret) is the "one safe
# environment source" fix: the app's real secrets live only in backend/.env; this file only
# exists so the Prisma CLI can find the database connection string.
DATABASE_URL="mysql://REPLACE_ME"
