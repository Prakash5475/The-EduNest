# ============================================================================
# THE EDUNEST — Backend environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug

# --- Database (MySQL via Prisma) ---
DATABASE_URL="mysql://edunest:edunest_pass@localhost:3306/edunest"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=the-edunest
JWT_AUDIENCE=the-edunest-clients

# --- Cookies ---
COOKIE_SECRET=replace_with_a_long_random_secret
REFRESH_COOKIE_NAME=edunest_rt

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Nodemailer / SMTP ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASS=replace_me
MAIL_FROM_NAME="The EduNest"
MAIL_FROM_ADDRESS=no-reply@theedunest.com

# --- WhatsApp (Meta Cloud API) ---
# Leave blank to disable. Get these from developers.facebook.com > your app > WhatsApp > API Setup.
# An approved message template (e.g. "otp_verification") is required for OTP messages.
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_me

# --- BullMQ ---
QUEUE_PREFIX=edunest

# --- Razorpay ---
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Minimum percentage of an order's total that must be paid up front (business rule: 50%)
ADVANCE_PAYMENT_MIN_PERCENT=50

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_ROUTE=/docs

# --- Company GST profile (pre-launch fallback only — public, statutory info, not a secret) ---
# The authoritative source is Admin Settings > Company/GST (ApplicationSetting rows,
# company_gst_state / company_gstin / company_legal_name / etc. — seeded by migration
# 20260904000000_seed_company_gst_profile). These two env vars only matter if that table is
# ever empty (e.g. brand-new environment before the seed migration has run).
COMPANY_GST_STATE=Maharashtra
COMPANY_GSTIN=27CIEP38036K1ZY
