# ============================================================================
# THE EDUNEST — Backend environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug

# --- Database (MySQL via Prisma) ---
DATABASE_URL="mysql://edunest:edunest_pass@localhost:3306/edunest"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# WhatsApp Business API — leave WHATSAPP_PROVIDER=none to keep this disabled.
# Set to meta_cloud and fill in credentials to enable real delivery via the
# official Meta WhatsApp Cloud API.
WHATSAPP_PROVIDER=none
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Inbound webhook (Meta GET verification handshake + POST signature validation)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
REDIS_PREFIX=edunest:

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=the-edunest
JWT_AUDIENCE=the-edunest-clients

# --- Cookies ---
COOKIE_SECRET=replace_with_a_long_random_secret
REFRESH_COOKIE_NAME=edunest_rt

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Nodemailer / SMTP ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASS=replace_me
MAIL_FROM_NAME="The EduNest"
MAIL_FROM_ADDRESS=no-reply@theedunest.com

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_UPLOAD_FOLDER=edunest

# --- BullMQ ---
QUEUE_PREFIX=edunest

# --- Razorpay ---
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Minimum percentage of an order's total that must be paid up front (business rule: 50%)
ADVANCE_PAYMENT_MIN_PERCENT=50

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_ROUTE=/docs
