# Base URL for the backend API (include the /api/v1 prefix).
# Must match the backend's PORT (see backend/.env.example — default 4000), not 5000.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Socket.IO server URL. Defaults to the same origin ("/") if unset.
VITE_SOCKET_URL=http://localhost:4000
